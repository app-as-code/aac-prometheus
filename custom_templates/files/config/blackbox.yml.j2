modules:
  icmp_ipv4:
    prober: icmp
    timeout: {{ vars.BLACKBOX_TIMEOUT | default('5s') }}
    icmp:
      preferred_ip_protocol: "ip4"

  dns_recursive_google:
    prober: dns
    timeout: {{ vars.BLACKBOX_TIMEOUT | default('5s') }}
    dns:
      query_name: "google.de"
      query_type: "A"
      valid_rcodes: ["NOERROR"]
      preferred_ip_protocol: "ip4"

  dns_auth_int_zone:
    prober: dns
    timeout: {{ vars.BLACKBOX_TIMEOUT | default('5s') }}
    dns:
      query_name: "{{ vars.INTERNAL_DNS_ZONE | default('int.example.com') }}"
      query_type: "SOA"
      valid_rcodes: ["NOERROR"]
      preferred_ip_protocol: "ip4"

  dns_auth_ad_zone:
    prober: dns
    timeout: {{ vars.BLACKBOX_TIMEOUT | default('5s') }}
    dns:
      query_name: "{{ vars.AD_DNS_ZONE | default('ad.example.com') }}"
      query_type: "SOA"
      valid_rcodes: ["NOERROR"]
      preferred_ip_protocol: "ip4"

  http_2xx:
    prober: http
    timeout: {{ vars.BLACKBOX_TIMEOUT | default('5s') }}
    http:
      valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
      valid_status_codes: []
      method: GET
      no_follow_redirects: false
      preferred_ip_protocol: "ip4"
      ip_protocol_fallback: false